# Same secret as OMI_GATEWAY_SECRET in the Omi-enabled Go API; at least 32 characters.
OMI_GATEWAY_SECRET=
# Create this persistent directory with mode 0700 and gateway ownership.
OMI_SESSION_DIR=
OMI_API_URL=http://127.0.0.1:8081
OMI_GATEWAY_PORT=8095
# Optional path to installed Chromium.
OMI_CHROMIUM_PATH=
